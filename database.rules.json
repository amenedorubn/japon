{
  "rules": {
    ".read": false,
    ".write": false,

    "proyectos": {

      "viaje-japon": {

        ".read": "auth != null && root.child('proyectos/viaje-japon/access/users/' + auth.uid + '/status').val() === 'approved'",
        ".write": false,

        "state": {
          ".write": "auth != null && root.child('proyectos/viaje-japon/access/users/' + auth.uid + '/status').val() === 'approved'"
        },

        "tripTitle": {
          ".write": "auth != null && root.child('proyectos/viaje-japon/access/users/' + auth.uid + '/role').val() === 'admin'"
        },

        "access": {

          "adminEmail": {
            ".read": "auth != null"
          },

          "users": {
            ".read": "auth != null && root.child('proyectos/viaje-japon/access/users/' + auth.uid + '/role').val() === 'admin'",

            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && ((auth.uid === $uid && !data.exists() && auth.token.email_verified === true && newData.child('status').val() === 'pending' && newData.child('role').val() === 'traveler') || root.child('proyectos/viaje-japon/access/users/' + auth.uid + '/role').val() === 'admin')",

              "uid":         { ".validate": "newData.val() === $uid" },
              "email":       { ".validate": "auth.uid !== $uid || newData.val() === auth.token.email" },
              "displayName": { ".validate": "newData.isString() && newData.val().length <= 100" },
              "photoURL":    { ".validate": "newData.isString() && newData.val().length <= 500" },
              "createdAt":   { ".validate": "newData.isNumber()" },
              "role":        { ".validate": "newData.val() === 'traveler' || newData.val() === 'admin'" },
              "status":      { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected'" }
            }
          }
        }
      },

      "japon27-app-v2": {
        ".read": "auth != null && root.child('proyectos/viaje-japon/access/users/' + auth.uid + '/status').val() === 'approved'",
        ".write": "auth != null && root.child('proyectos/viaje-japon/access/users/' + auth.uid + '/status').val() === 'approved'"
      }
    }
  }
}